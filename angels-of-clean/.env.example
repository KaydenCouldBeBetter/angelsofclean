# Copy to .env.local and fill in. Never commit .env.local.
#
# For the local Supabase stack, README.md shows a one-liner that fills these from
# `npx supabase status`. For a hosted project, copy them from the Supabase
# dashboard: Project Settings, API.

# Supabase project URL. Used in the browser and on the server.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon (publishable) key. Used in the browser and on the server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row-level security. Used only for the public booking and
# quote inserts and the rate limiter. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
